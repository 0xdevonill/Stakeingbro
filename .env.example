# StakeBro environment
# Copy to .env.local. Never put private keys or seed phrases in this file.

# mock | live
NEXT_PUBLIC_DATA_MODE=mock

# Robinhood Chain (mainnet 4663, testnet 46630)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_NATIVE_SYMBOL=ETH
NEXT_PUBLIC_NATIVE_NAME=Ether

# Optional dedicated RPC (Alchemy, QuickNode, etc.)
# NEXT_PUBLIC_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY

# Contract addresses — leave empty until independently audited contracts are deployed
NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=
NEXT_PUBLIC_STAKING_FACTORY_ADDRESS=
NEXT_PUBLIC_PLATFORM_TREASURY_ADDRESS=

# Official Uniswap deployments on Robinhood Chain (public DEX)
NEXT_PUBLIC_UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
NEXT_PUBLIC_UNISWAP_SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
NEXT_PUBLIC_UNISWAP_QUOTER_V2=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
NEXT_PUBLIC_UNISWAP_UNIVERSAL_ROUTER=0x8876789976dEcBfCbBbe364623C63652db8C0904
NEXT_PUBLIC_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
NEXT_PUBLIC_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Fees in basis points (1% = 100). Displayed in the UI; live values should be read from contracts.
NEXT_PUBLIC_PLATFORM_FEE_BPS=30
NEXT_PUBLIC_DEFAULT_CREATOR_FEE_BPS=50
NEXT_PUBLIC_DEFAULT_TRADING_FEE_BPS=30

# Indexer / application API (optional). Blockchain remains the source of truth for funds.
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Comma-separated admin wallet addresses. No access if empty.
NEXT_PUBLIC_ADMIN_ADDRESSES=
